# Expo SDK 57 ships imprecise peer ranges (for example react-dom, a transitive web-only
# dependency, floats to a newer react than the SDK-pinned react used by the native app).
# npm's strict peer resolver errors on that skew even though it does not affect the app,
# so relax it here. This mirrors what `expo install` does and keeps `npm install` working
# in this non-workspace app package.
legacy-peer-deps=true
